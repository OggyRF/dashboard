// HI Digital team dashboard: database schema.
// Phase 0 covers people, sessions and the audit trail. Later phases add their
// models here (attendance, clients, tasks, synced Google data and so on).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STRATEGY
  EXECUTION
  OFFPAGE
}

enum UserStatus {
  ACTIVE
  DISABLED
  // Removed by an owner. Kept so past attendance, leave and messages still
  // show who did what; hidden everywhere else and unable to sign in.
  DELETED
}

model User {
  id                 String     @id @default(cuid())
  name               String
  // Stored lowercased; any provider (Gmail, company mail, ...) is fine.
  email              String     @unique
  passwordHash       String     @map("password_hash")
  role               Role
  status             UserStatus @default(ACTIVE)
  // Set when an owner creates the account or resets the password.
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until")
  lastLoginAt        DateTime?  @map("last_login_at")
  // Bumped on every photo change; doubles as a cache-busting version.
  avatarUpdatedAt    DateTime?  @map("avatar_updated_at")
  deletedAt          DateTime?  @map("deleted_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  sessions  Session[]
  auditLogs AuditLog[]

  attendanceDays        AttendanceDay[]
  attendanceEvents      AttendanceEvent[]      @relation("EventUser")
  attendanceCorrections AttendanceCorrection[]
  leaveRequests         LeaveRequest[]         @relation("LeaveRequester")
  leaveDecisions        LeaveRequest[]         @relation("LeaveDecider")
  messageThreads        MessageThread[]
  messageParticipants   MessageParticipant[]
  messages              Message[]
  messageReads          MessageRead[]
  notifications         Notification[]
  avatar                UserAvatar?

  clientsCreated       Client[]           @relation("ClientCreator")
  clientsStrategic     Client[]           @relation("ClientStrategicOwner")
  clientsExecution     Client[]           @relation("ClientExecutionOwner")
  clientsOffpage       Client[]           @relation("ClientOffpageOwner")
  clientAssignments    ClientAssignment[]
  activityEvents       ActivityEvent[]
  tasksAssigned        Task[]             @relation("TaskAssignee")
  tasksFollowingUp     Task[]             @relation("TaskFollowUp")
  tasksCreated         Task[]             @relation("TaskCreator")
  taskComments         TaskComment[]
  offpageActivities    OffpageActivity[]  @relation("OffpageAssignee")
  offpageReviews       OffpageActivity[]  @relation("OffpageReviewer")
  offpageItemsAssigned OffpageItem[]      @relation("OffpageItemAssignee")
  offpageItemsDone     OffpageItem[]      @relation("OffpageItemDoneBy")
  offpageItemsRejected OffpageItem[]      @relation("OffpageItemRejectedBy")
  chatMessages         ChatMessage[]
  chatReactions        ChatReaction[]
  channelReads         ChannelRead[]
  dailyTasks           DailyTask[]        @relation("DailyTaskAssignee")
  dailyTasksCreated    DailyTask[]        @relation("DailyTaskCreator")
  dailyTicks           DailyTaskTick[]
  dailyFollowUps       DailyTask[]        @relation("DailyTaskFollowUp")
  dailyPlanRuns        DailyPlanRun[]

  @@map("users")
}

// Profile photo, kept apart from User so loading a session never reads it.
model UserAvatar {
  userId      String   @id @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String   @map("content_type")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_avatars")
}

model Session {
  // SHA-256 of the random token held in the browser cookie. The raw token is
  // never stored, so a leaked database cannot be used to sign in.
  id         String   @id
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  expiresAt  DateTime @map("expires_at")
  ip         String?
  userAgent  String?  @map("user_agent")

  @@index([userId])
  @@map("sessions")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip, createdAt])
  @@index([email, createdAt])
  @@map("login_attempts")
}

// Append-only security record of every change. Never updated or deleted by the app.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 1: attendance, leave, messages to owners, notifications
// ---------------------------------------------------------------------------

enum AttendanceEventType {
  LOGIN
  BREAK_START
  BREAK_END
  LOGOUT
}

enum AttendanceEventSource {
  USER // pressed the button; time is the server clock
  SYSTEM // closed automatically at the end of the day
  OWNER // added by an owner as a correction
}

// One row per person per India-time calendar day. Totals are recalculated
// from the events every time an event or correction is added.
model AttendanceDay {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime  @db.Date
  firstLoginAt  DateTime? @map("first_login_at")
  lastLogoutAt  DateTime? @map("last_logout_at")
  workedMinutes Int       @default(0) @map("worked_minutes")
  breakMinutes  Int       @default(0) @map("break_minutes")
  breakCount    Int       @default(0) @map("break_count")
  // Closed by the end-of-day job because nobody pressed Log out; owners review these.
  autoClosed    Boolean   @default(false) @map("auto_closed")
  corrected     Boolean   @default(false)
  // Last sign of life from the person's laptop while a session is open
  // (button presses and the dashboard's once-a-minute heartbeat). Null when
  // no session is open. When it goes quiet the session is stopped here.
  lastSeenAt    DateTime? @map("last_seen_at")
  // What the person worked on, written when they log out for the day.
  workNote      String?   @map("work_note")
  workNoteAt    DateTime? @map("work_note_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  events      AttendanceEvent[]
  corrections AttendanceCorrection[]

  @@unique([userId, date])
  @@index([date])
  @@map("attendance_days")
}

// Append-only. Members can only add events by pressing the buttons; the time
// always comes from the server. Owner corrections never edit a row: they are
// stored in AttendanceCorrection and applied on top.
model AttendanceEvent {
  id        String                @id @default(cuid())
  dayId     String                @map("day_id")
  day       AttendanceDay         @relation(fields: [dayId], references: [id], onDelete: Cascade)
  userId    String                @map("user_id")
  user      User                  @relation("EventUser", fields: [userId], references: [id], onDelete: Cascade)
  type      AttendanceEventType
  at        DateTime
  source    AttendanceEventSource @default(USER)
  // Why the system added this event, e.g. the laptop went quiet.
  note      String?
  ip        String?
  createdAt DateTime              @default(now()) @map("created_at")

  corrections AttendanceCorrection[]

  @@index([dayId, at])
  @@index([userId, at])
  @@map("attendance_events")
}

enum CorrectionKind {
  CHANGE_TIME
  ADD_EVENT
  REMOVE_EVENT
}

model AttendanceCorrection {
  id            String          @id @default(cuid())
  dayId         String          @map("day_id")
  day           AttendanceDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  eventId       String          @map("event_id")
  event         AttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind          CorrectionKind
  oldAt         DateTime?       @map("old_at")
  newAt         DateTime?       @map("new_at")
  reason        String
  correctedById String          @map("corrected_by_id")
  correctedBy   User            @relation(fields: [correctedById], references: [id])
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([dayId])
  @@map("attendance_corrections")
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

enum LeaveType {
  CASUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String      @map("user_id")
  user         User        @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  fromDate     DateTime    @map("from_date") @db.Date
  toDate       DateTime    @map("to_date") @db.Date
  halfDay      Boolean     @default(false) @map("half_day")
  // Working days the request covers (weekly offs and holidays excluded), 0.5 for a half day.
  days         Decimal     @db.Decimal(5, 1)
  type         LeaveType
  reason       String
  status       LeaveStatus @default(PENDING)
  decidedById  String?     @map("decided_by_id")
  decidedBy    User?       @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt    DateTime?   @map("decided_at")
  decisionNote String?     @map("decision_note")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([userId, fromDate])
  @@index([status])
  @@map("leave_requests")
}

// A conversation a team member starts with the owners.
model MessageThread {
  id            String   @id @default(cuid())
  fromUserId    String   @map("from_user_id")
  fromUser      User     @relation(fields: [fromUserId], references: [id], onDelete: Cascade)
  subject       String
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  messages     Message[]
  reads        MessageRead[]
  participants MessageParticipant[]

  @@index([fromUserId])
  @@index([lastMessageAt])
  @@map("message_threads")
}

model Message {
  id        String        @id @default(cuid())
  threadId  String        @map("thread_id")
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String        @map("author_id")
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([threadId, createdAt])
  @@map("messages")
}

// Everyone on a conversation, including whoever started it.
model MessageParticipant {
  threadId String        @map("thread_id")
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String        @map("user_id")
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
  @@map("message_participants")
}

model MessageRead {
  threadId   String        @map("thread_id")
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime      @map("last_read_at")

  @@id([threadId, userId])
  @@map("message_reads")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Phase 2: clients, tasks, off-page tracker, client chat
// ---------------------------------------------------------------------------

enum ClientType {
  SEO
  GMB
  BOTH
}

enum ClientStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  CHURNED
}

enum Responsibility {
  STRATEGY
  EXECUTION
  OFFPAGE
  QA
}

model Client {
  id               String       @id @default(cuid())
  name             String
  website          String?
  type             ClientType
  industry         String?
  location         String?
  status           ClientStatus @default(ACTIVE)
  startDate        DateTime?    @map("start_date") @db.Date
  goals            String?
  notes            String?
  strategicOwnerId String?      @map("strategic_owner_id")
  strategicOwner   User?        @relation("ClientStrategicOwner", fields: [strategicOwnerId], references: [id], onDelete: SetNull)
  // The SEO Project Manager checks this client's off-page work.
  executionOwnerId String?      @map("execution_owner_id")
  executionOwner   User?        @relation("ClientExecutionOwner", fields: [executionOwnerId], references: [id], onDelete: SetNull)
  // Shown as "SEO Strategist", "SEO Project Manager" and "Off-Page SEO
  // Specialist"; each also has a matching assignment row.
  offpageOwnerId   String?      @map("offpage_owner_id")
  offpageOwner     User?        @relation("ClientOffpageOwner", fields: [offpageOwnerId], references: [id], onDelete: SetNull)
  createdById      String?      @map("created_by_id")
  createdBy        User?        @relation("ClientCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  assignments       ClientAssignment[]
  activity          ActivityEvent[]
  tasks             Task[]
  offpageActivities OffpageActivity[]
  offpageMonths     OffpageMonth[]
  offpageItems      OffpageItem[]
  offpageMonthQtys  OffpageMonthQty[]
  dailyTasks        DailyTask[]
  channel           Channel?
  dataSources       ClientDataSource[]

  @@index([status])
  @@map("clients")
}

// Who works on a client. Drives who can see the client and its channel.
// The strategic and execution owners always have a matching row.
model ClientAssignment {
  clientId       String         @map("client_id")
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  responsibility Responsibility
  createdAt      DateTime       @default(now()) @map("created_at")

  @@id([clientId, userId, responsibility])
  @@index([userId])
  @@map("client_assignments")
}

// The client's timeline: what happened, who did it, where to look.
model ActivityEvent {
  id        BigInt   @id @default(autoincrement())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  summary   String
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, createdAt])
  @@map("activity_events")
}

// Shown as Not started, Under process and Completed.
enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskCategory {
  TECHNICAL
  ON_PAGE
  CONTENT
  OFF_PAGE
  GMB
  REPORTING
  RESEARCH
  PLANNING
  STRATEGY
  OTHER
}

model Task {
  id                String       @id @default(cuid())
  // Short number people type in chat as #12.
  number            Int          @unique @default(autoincrement())
  clientId          String       @map("client_id")
  client            Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  category          TaskCategory @default(OTHER)
  priority          TaskPriority @default(MEDIUM)
  assigneeId        String?      @map("assignee_id")
  assignee          User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Who chases the task along; told when it is done or late.
  followUpId        String?      @map("follow_up_id")
  followUp          User?        @relation("TaskFollowUp", fields: [followUpId], references: [id], onDelete: SetNull)
  dueDate           DateTime?    @map("due_date") @db.Date
  status            TaskStatus   @default(NOT_STARTED)
  completedAt       DateTime?    @map("completed_at")
  // Set once the "past its due date" alert has gone out; cleared when the
  // due date changes or the task is reopened.
  overdueNotifiedAt DateTime?    @map("overdue_notified_at")
  // The chat message this task was made from, if any.
  sourceMessageId   String?      @map("source_message_id")
  createdById       String?      @map("created_by_id")
  createdBy         User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  comments TaskComment[]

  @@index([clientId, status])
  @@index([assigneeId, status])
  @@index([followUpId, status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// A client's standing monthly off-page work, e.g. "Guest Posting, 10 a month,
// done by Huzaif, checked by Saad". Changes apply from next month unless
// applied to the current month too.
model OffpageActivity {
  id         String    @id @default(cuid())
  clientId   String    @map("client_id")
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  monthlyQty Int       @map("monthly_qty")
  assigneeId String?   @map("assignee_id")
  assignee   User?     @relation("OffpageAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reviewerId String?   @map("reviewer_id")
  reviewer   User?     @relation("OffpageReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  position   Int       @default(0)
  // Set for an extra activity added to one month only ("2026-12").
  onlyMonth  String?   @map("only_month")
  removedAt  DateTime? @map("removed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  items      OffpageItem[]
  monthQtys  OffpageMonthQty[]
  dailyTasks DailyTask[]

  @@index([clientId])
  @@map("offpage_activities")
}

// A one-month change to an activity's quantity, e.g. 15 image submissions in
// December instead of the usual 10. 0 skips the activity that month.
model OffpageMonthQty {
  activityId String          @map("activity_id")
  activity   OffpageActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  clientId   String          @map("client_id")
  client     Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month      String
  qty        Int
  updatedAt  DateTime        @updatedAt @map("updated_at")

  @@id([activityId, month])
  @@index([clientId, month])
  @@map("offpage_month_qtys")
}

// Marks that a client's checklist for a month ("2026-10") has been created.
model OffpageMonth {
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     String
  createdAt DateTime @default(now()) @map("created_at")

  @@id([clientId, month])
  @@map("offpage_months")
}

// One checkbox: a single planned piece of work in one week of a month.
model OffpageItem {
  id           String          @id @default(cuid())
  clientId     String          @map("client_id")
  client       Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  activityId   String          @map("activity_id")
  activity     OffpageActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  month        String
  week         Int
  assigneeId   String?         @map("assignee_id")
  assignee     User?           @relation("OffpageItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  doneAt       DateTime?       @map("done_at")
  doneById     String?         @map("done_by_id")
  doneBy       User?           @relation("OffpageItemDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  proofUrl     String?         @map("proof_url")
  rejectedAt   DateTime?       @map("rejected_at")
  rejectedById String?         @map("rejected_by_id")
  rejectedBy   User?           @relation("OffpageItemRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectReason String?         @map("reject_reason")
  createdAt    DateTime        @default(now()) @map("created_at")

  dailyTick DailyTaskTick?

  @@index([clientId, month])
  @@index([assigneeId, month])
  @@index([activityId, month])
  @@map("offpage_items")
}

enum ChannelKind {
  CLIENT
  TEAM
}

// A chat room. Each client has one; "general" is for the whole team. Who can
// read a client channel follows the client's assignments.
model Channel {
  id        String      @id @default(cuid())
  name      String      @unique
  kind      ChannelKind
  clientId  String?     @unique @map("client_id")
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now()) @map("created_at")

  messages ChatMessage[]
  reads    ChannelRead[]

  @@map("channels")
}

model ChatMessage {
  id        String        @id @default(cuid())
  channelId String        @map("channel_id")
  channel   Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String        @map("author_id")
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  // Set on replies inside a thread.
  parentId  String?       @map("parent_id")
  parent    ChatMessage?  @relation("ChatThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   ChatMessage[] @relation("ChatThread")
  // The message this one quotes (WhatsApp-style reply).
  replyToId String?       @map("reply_to_id")
  replyTo   ChatMessage?  @relation("ChatQuote", fields: [replyToId], references: [id], onDelete: SetNull)
  quotedBy  ChatMessage[] @relation("ChatQuote")
  editedAt  DateTime?     @map("edited_at")
  // Soft delete: the text is cleared, the row stays for the audit trail.
  deletedAt DateTime?     @map("deleted_at")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  reactions   ChatReaction[]
  attachments ChatAttachment[]

  @@index([channelId, createdAt])
  @@index([parentId, createdAt])
  @@map("chat_messages")
}

model ChatReaction {
  messageId String      @map("message_id")
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now()) @map("created_at")

  @@id([messageId, userId, emoji])
  @@map("chat_reactions")
}

model ChannelRead {
  channelId  String   @map("channel_id")
  channel    Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @map("last_read_at")

  @@id([channelId, userId])
  @@index([userId])
  @@map("channel_reads")
}

// A picture shared in chat. Kept in the database (the free hosting has no
// file storage), shrunk in the browser before upload.
model ChatAttachment {
  id          String      @id @default(cuid())
  messageId   String      @map("message_id")
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String      @map("content_type")
  size        Int
  width       Int?
  height      Int?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([messageId])
  @@map("chat_attachments")
}

// ---------------------------------------------------------------------------
// Daily task list for off-page staff
// ---------------------------------------------------------------------------

enum DailyWork {
  WRITING
  UPLOADING
  OTHER
}

// One line on someone's list for a day, e.g. "Write 2 Guest Posting blogs for
// IIT Bombay". Ticking an UPLOADING unit with its live link also ticks the next
// open box of that activity in the client's off-page checklist.
model DailyTask {
  id          String           @id @default(cuid())
  date        DateTime         @db.Date
  assigneeId  String           @map("assignee_id")
  assignee    User             @relation("DailyTaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  clientId    String           @map("client_id")
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  activityId  String?          @map("activity_id")
  activity    OffpageActivity? @relation(fields: [activityId], references: [id], onDelete: SetNull)
  work        DailyWork
  // Free text for OTHER work, or extra detail ("topic: dental implants").
  details     String?
  qty         Int
  // Who checks the work: the client's SEO Project Manager unless chosen.
  followUpId  String?          @map("follow_up_id")
  followUp    User?            @relation("DailyTaskFollowUp", fields: [followUpId], references: [id], onDelete: SetNull)
  // Made by the automatic daily plan rather than by a person.
  auto        Boolean          @default(false)
  createdById String?          @map("created_by_id")
  createdBy   User?            @relation("DailyTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  ticks DailyTaskTick[]

  @@index([assigneeId, date])
  @@index([date])
  @@index([followUpId, date])
  @@map("daily_tasks")
}

// One unit of a daily task (unit n of qty) that has been started. Working
// while doneAt is empty, completed once it is set.
model DailyTaskTick {
  id            String       @id @default(cuid())
  dailyTaskId   String       @map("daily_task_id")
  dailyTask     DailyTask    @relation(fields: [dailyTaskId], references: [id], onDelete: Cascade)
  n             Int
  startedAt     DateTime     @default(now()) @map("started_at")
  doneAt        DateTime?    @map("done_at")
  doneById      String?      @map("done_by_id")
  doneBy        User?        @relation(fields: [doneById], references: [id], onDelete: SetNull)
  proofUrl      String?      @map("proof_url")
  // The off-page checklist box this unit ticked, if any.
  offpageItemId String?      @unique @map("offpage_item_id")
  offpageItem   OffpageItem? @relation(fields: [offpageItemId], references: [id], onDelete: SetNull)

  @@unique([dailyTaskId, n])
  @@map("daily_task_ticks")
}

// Marks that someone's automatic daily plan was made for a day, so it is made
// once and stays put through the day.
model DailyPlanRun {
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, date])
  @@map("daily_plan_runs")
}

// ---- Phase 3: Google Search Console ----

// The one agency Google account the dashboard reads Search Console through.
// Only the refresh token is kept, encrypted with TOKEN_ENCRYPTION_KEY.
model GoogleConnection {
  id              String    @id @default("agency")
  email           String
  refreshTokenEnc String    @map("refresh_token_enc")
  connectedById   String?   @map("connected_by_id")
  connectedAt     DateTime  @default(now()) @map("connected_at")
  // Set when Google stops accepting the token; cleared by reconnecting.
  brokenAt        DateTime? @map("broken_at")
  lastError       String?   @map("last_error")

  @@map("google_connections")
}

enum DataSourceKind {
  GSC
}

// Which Google property a client's data comes from, and how far its sync got.
model ClientDataSource {
  id           String         @id @default(cuid())
  clientId     String         @map("client_id")
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind         DataSourceKind
  // For Search Console: the property, e.g. "sc-domain:example.com".
  externalId   String         @map("external_id")
  createdById  String?        @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  // Day (India time) the recent days and current month were last pulled.
  recentSyncedOn DateTime?    @map("recent_synced_on") @db.Date
  // Next month of history to pull ("2026-08"), going back; null when done.
  backfillMonth  String?      @map("backfill_month")
  lastSyncAt     DateTime?    @map("last_sync_at")
  lastError      String?      @map("last_error")

  gscDaily GscDailyTotal[]
  gscRows  GscRow[]

  @@unique([clientId, kind])
  @@map("client_data_sources")
}

// Whole-site totals per day, exactly as the Search Console chart shows them.
model GscDailyTotal {
  dataSourceId String           @map("data_source_id")
  dataSource   ClientDataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  clicks       Int
  impressions  Int
  // Average position, weighted by impressions.
  position     Float

  @@id([dataSourceId, date])
  @@map("gsc_daily_totals")
}

enum GscDimension {
  QUERY
  PAGE
  QUERY_PAGE
  DEVICE
  COUNTRY
}

// Top rows per month for one breakdown (queries, pages, ...). key2 is the page
// for QUERY_PAGE rows and empty otherwise.
model GscRow {
  id           BigInt           @id @default(autoincrement())
  dataSourceId String           @map("data_source_id")
  dataSource   ClientDataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)
  month        String
  dimension    GscDimension
  key1         String
  key2         String           @default("")
  clicks       Int
  impressions  Int
  position     Float

  @@index([dataSourceId, month, dimension, clicks(sort: Desc)])
  @@map("gsc_rows")
}

// A short lock so only one sync runs at a time across serverless calls.
model SyncLease {
  name      String   @id
  holder    String
  expiresAt DateTime @map("expires_at")

  @@map("sync_leases")
}
