# Copy to .env (local) or the server's env file, and fill in real values there.
# Never commit .env files or put these values in code.

# PostgreSQL connection. In production use the managed database URL with sslmode=require.
DATABASE_URL="postgresql://postgres@localhost:5432/hidigital"

# Public address of the app.
APP_URL="http://localhost:3000"

# Used by Docker Compose and Caddy in production.
APP_DOMAIN="team.hidigital.co.in"
ACME_EMAIL="aarif@hidigital.co.in"

# Google Search Console (Phase 3). Create a Web OAuth client in Google Cloud with
# the redirect URI <APP_URL>/api/google/callback, then set these three. Without
# them the Google pages simply say the keys are missing.
# TOKEN_ENCRYPTION_KEY=   # any long random text; encrypts the saved Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Later phases (left empty until then):
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# R2_ACCOUNT_ID= / R2_ACCESS_KEY_ID= / R2_SECRET_ACCESS_KEY= / R2_BUCKET=
# SENTRY_DSN=
