# Copy to .env (local) or the server's env file, and fill in real values there.
# Never commit .env files or put these values in code.

# PostgreSQL connection. In production use the managed database URL with sslmode=require.
DATABASE_URL="postgresql://postgres@localhost:5432/hidigital"

# Public address of the app.
APP_URL="http://localhost:3000"

# Used by Docker Compose and Caddy in production.
APP_DOMAIN="team.hidigital.co.in"
ACME_EMAIL="aarif@hidigital.co.in"

